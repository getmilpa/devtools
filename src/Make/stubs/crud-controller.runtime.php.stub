<?php

declare(strict_types=1);

namespace {{namespace}};

use {{entityNamespace}}\{{entityClass}};
use Milpa\Data\PagesResults;
use Milpa\Data\RepositoryInterface;
use Milpa\Http\Routing\RouteResult;
use Nyholm\Psr7\Response;
use Psr\Http\Message\ResponseInterface;
use Psr\Http\Message\ServerRequestInterface;

/**
 * The 5 REST verbs for {{entityClass}} (`GET|POST /{{table}}`, `GET|PUT|DELETE /{{table}}/{id}` — see
 * the wiring plugin's routes()), backed by the {@see RepositoryInterface} the wiring plugin's boot()
 * constructs and registers this controller with. Path parameters (`{id}`) arrive via the PSR-7 request
 * attribute the kernel's RequestHandler decorates every matched request with — see {@see self::routeId()}
 * — never as an extra method parameter: milpa/runtime's CallableRequestHandler always invokes a route
 * handler with the request alone.
 */
final class {{class}}
{
    /** How many rows `index()` answers when the caller does not say. */
    private const int PAGE = 50;

    /** The most rows `index()` will answer however large a `?limit=` asks for. */
    private const int MAX_PAGE = 200;

    /** @param RepositoryInterface<{{entityClass}}> $repository */
    public function __construct(private readonly RepositoryInterface $repository)
    {
    }

    /**
     * A PAGE of {{entityClass}}, never the whole table.
     *
     * `?limit=` and `?offset=` bound the read, and the limit is capped: a listing endpoint that returns
     * everything works on the first hundred rows and falls over on the hundred thousandth, which is the
     * worst moment to find out. Ask for `?limit=1` and you get one — the caller can always page.
     *
     * The repository is asked whether it can page ({@see PagesResults}); a backend that cannot still
     * answers, from `all()`, because a listing that works is better than one that refuses.
     */
    public function index(ServerRequestInterface $request): ResponseInterface
    {
        $query = $request->getQueryParams();
        $limit = min(self::MAX_PAGE, max(0, (int) ($query['limit'] ?? self::PAGE)));
        $offset = max(0, (int) ($query['offset'] ?? 0));

        // ONE place decides what this caller may see; both read actions ask it.
        $criteria = $this->visibleTo($request);

        $entities = $this->repository instanceof PagesResults
            ? $this->repository->page($criteria, $limit, $offset)
            // A backend that cannot page is bounded HERE, after the same criteria — the fallback
            // used to slice `all()` unfiltered, which would have handed a stranger every row the
            // criteria exist to withhold.
            : \array_slice(
                array_values(array_filter(
                    $this->repository->all(),
                    fn ({{entityClass}} $entity): bool => $this->admits($entity, $criteria),
                )),
                $offset,
                $limit,
            );

        return $this->json(200, [
            'items' => array_map(
                static fn ({{entityClass}} $entity): array => $entity->toArray(),
                $entities,
            ),
            'limit' => $limit,
            'offset' => $offset,
        ]);
    }

    public function show(ServerRequestInterface $request): ResponseInterface
    {
        $entity = $this->repository->find($this->routeId($request));
        // 404 AND NOT 403 for a row this caller may not see, deliberately: a 403 confirms the row
        // exists, which tells a stranger there is something to look for. For whoever cannot see it,
        // it does not exist — the same reason the welcome page answers a count instead of the route
        // map it derives from.
        if ($entity === null || ! $this->admits($entity, $this->visibleTo($request))) {
            return $this->json(404, ['error' => 'not found']);
        }

        return $this->json(200, $entity->toArray());
    }

    public function create(ServerRequestInterface $request): ResponseInterface
    {
        $data = $this->decode($request);
        $data['id'] = null;

        $id = $this->repository->save({{entityClass}}::fromArray($data));
        $created = $this->repository->find($id);

        return $this->json(201, $created?->toArray() ?? $data);
    }

    public function update(ServerRequestInterface $request): ResponseInterface
    {
        $id = $this->routeId($request);
        $existing = $this->repository->find($id);
        if ($existing === null) {
            return $this->json(404, ['error' => 'not found']);
        }

        $data = array_merge($existing->toArray(), $this->decode($request));
        $data['id'] = $existing->id();

        $this->repository->save({{entityClass}}::fromArray($data));
        $updated = $this->repository->find($id);

        return $this->json(200, $updated?->toArray() ?? $data);
    }

    public function delete(ServerRequestInterface $request): ResponseInterface
    {
        $id = $this->routeId($request);
        if ($this->repository->find($id) === null) {
            return $this->json(404, ['error' => 'not found']);
        }

        $this->repository->delete($id);

        return new Response(204);
    }

    /** Reads the `{id}` path parameter the router bound to the matched route — see the class docblock. */
    private function routeId(ServerRequestInterface $request): int|string
    {
        $result = $request->getAttribute(RouteResult::ATTRIBUTE);

        return $result?->parameter('id') ?? '';
    }

    /** @return array<string, mixed> */
    private function decode(ServerRequestInterface $request): array
    {
        $decoded = json_decode((string) $request->getBody(), true);

        return is_array($decoded) ? $decoded : [];
    }

{{visibleToMethod}}
    /**
     * Whether an entity matches the criteria, with `query()`'s own semantics: strict equality on
     * `toArray()` values.
     *
     * The repository already applies these on the paged path; this is the same judgement for the
     * two places a repository cannot apply them — the unpaged fallback and a single `find()`. It is
     * ONE method rather than two comparisons so the paged and unpaged answers cannot drift.
     *
     * @param array<string, mixed> $criteria
     */
    private function admits({{entityClass}} $entity, array $criteria): bool
    {
        if ($criteria === []) {
            return true;
        }

        $row = $entity->toArray();
        foreach ($criteria as $field => $value) {
            if (($row[$field] ?? null) !== $value) {
                return false;
            }
        }

        return true;
    }

    /** @param array<string, mixed>|list<array<string, mixed>> $payload */
    private function json(int $status, array $payload): ResponseInterface
    {
        return new Response(
            $status,
            ['Content-Type' => 'application/json'],
            (string) json_encode($payload, JSON_UNESCAPED_UNICODE),
        );
    }
}
